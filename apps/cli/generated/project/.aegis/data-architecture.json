{
  "models": [
    {
      "name": "User",
      "description": "System users for history tracking",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        },
        {
          "name": "scans",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "ScanResult",
          "description": "User scan history"
        }
      ]
    },
    {
      "name": "ScanResult",
      "description": "Persistence of resume analysis results",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of scan"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated match percentage"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of missing skills"
        },
        {
          "name": "suggestions",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "AI-generated improvement advice"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of scan"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" }\ndatasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") }\n\nmodel User {\n  id        String       @id @default(uuid())\n  email     String       @unique\n  password  String\n  scans     ScanResult[]\n}\n\nmodel ScanResult {\n  id              String   @id @default(uuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id])\n  matchScore      Float\n  missingKeywords Json\n  suggestions     Json\n  createdAt       DateTime @default(now())\n}",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Upload resume, process via NLP, and return match analysis",
      "requestBodySchema": "{ \"resume\": \"File\", \"jobDescription\": \"string\" }",
      "responseBodySchema": "{ \"score\": number, \"missingKeywords\": string[], \"suggestions\": string[] }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Fetch user scan history",
      "responseBodySchema": "ScanResult[]"
    },
    {
      "path": "/api/v1/history/:id",
      "method": "DELETE",
      "description": "Delete a specific scan record",
      "responseBodySchema": "{ \"success\": boolean }"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData (file + jobDescription)",
      "returns": "analysisResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "void",
      "returns": "ScanResult[]"
    }
  ]
}