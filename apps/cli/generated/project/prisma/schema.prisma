generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  scans         ScanResult[]
  createdAt     DateTime @default(now())
}

model ScanResult {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  fileName         String
  matchPercentage  Int
  matchedKeywords  String[]
  missingKeywords  String[]
  createdAt        DateTime @default(now())
}