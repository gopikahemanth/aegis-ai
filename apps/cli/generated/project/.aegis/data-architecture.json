{
  "models": [
    {
      "name": "User",
      "description": "Authenticated system user",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        }
      ]
    },
    {
      "name": "AnalysisResult",
      "description": "Stores the result of a resume versus job description scan",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the analysis"
        },
        {
          "name": "resumeFileName",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Original file name"
        },
        {
          "name": "jobDescription",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job text"
        },
        {
          "name": "matchPercentage",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated score"
        },
        {
          "name": "missingSkills",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of missing keywords"
        },
        {
          "name": "suggestions",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Actionable improvements"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "datasource db { provider = \"sqlite\" url = \"file:./dev.db\" } generator client { provider = \"prisma-client-js\" } model User { id String @id @default(uuid()) email String @unique password String analyses AnalysisResult[] } model AnalysisResult { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) resumeFileName String jobDescription String matchPercentage Float missingSkills String suggestions String createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/analyze",
      "method": "POST",
      "description": "Uploads resume and job description to perform NLP analysis",
      "requestBodySchema": "{ \"resumeBase64\": \"string\", \"jobDescription\": \"string\" }",
      "responseBodySchema": "{ \"matchPercentage\": \"number\", \"missingSkills\": \"string[]\", \"suggestions\": \"string[]\" }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Retrieves scan history for the authenticated user",
      "responseBodySchema": "AnalysisResult[]"
    },
    {
      "path": "/api/v1/history/:id",
      "method": "DELETE",
      "description": "Deletes a specific analysis record",
      "responseBodySchema": "{ \"message\": \"string\" }"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/analyze",
      "params": "none",
      "returns": "AnalysisResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "userId: string",
      "returns": "AnalysisResult[]"
    }
  ]
}