{
  "models": [
    {
      "name": "User",
      "description": "System authenticated user",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Security hash"
        }
      ]
    },
    {
      "name": "ResumeScan",
      "description": "Record of a resume versus job description analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Scan identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "jobTitle",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target role"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated percentage"
        },
        {
          "name": "matchedKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of found keywords"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of gaps"
        },
        {
          "name": "resumeS3Key",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Reference to S3 object"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "model User { id String @id @default(uuid()) email String @unique passwordHash String scans ResumeScan[] } model ResumeScan { id String @id @default(uuid()) user User @relation(fields: [userId], references: [id]) userId String jobTitle String matchScore Float matchedKeywords Json missingKeywords Json resumeS3Key String createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Upload resume, parse, analyze, and store scan results",
      "requestBodySchema": "{ resumeFile: File, jobDescription: string, jobTitle: string }",
      "responseBodySchema": "{ id: string, matchScore: number, matchedKeywords: string[], missingKeywords: string[] }"
    },
    {
      "path": "/api/v1/scan/history",
      "method": "GET",
      "description": "Retrieve all scan history for the authenticated user",
      "responseBodySchema": "ResumeScan[]"
    }
  ],
  "hooks": [
    {
      "name": "useCreateScan",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData (resume, jobDescription, jobTitle)",
      "returns": "ResumeScan"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scan/history",
      "params": "none",
      "returns": "ResumeScan[]"
    }
  ]
}