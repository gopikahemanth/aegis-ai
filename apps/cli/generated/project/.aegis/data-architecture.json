{
  "models": [
    {
      "name": "User",
      "description": "System users with authentication credentials",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique email for auth"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Bcrypt hashed password"
        },
        {
          "name": "scans",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Scan",
          "description": "One-to-many relation to scans"
        }
      ]
    },
    {
      "name": "Scan",
      "description": "Historical scan session containing resume and job description matching data",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "resumeContent",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted text from resume"
        },
        {
          "name": "jobDescription",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Source job description text"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "AI calculated relevance percentage"
        },
        {
          "name": "matchedKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "JSON array of common keywords"
        },
        {
          "name": "missingSkills",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "JSON array of detected gaps"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Scan timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "model User {\n  id        String @id @default(uuid())\n  email     String @unique\n  passwordHash String\n  scans     Scan[]\n}\n\nmodel Scan {\n  id              String   @id @default(uuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id])\n  resumeContent   String\n  jobDescription  String\n  matchScore      Float\n  matchedKeywords Json\n  missingSkills   Json\n  createdAt       DateTime @default(now())\n}",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Creates a new user account",
      "requestBodySchema": "{ email, password }",
      "responseBodySchema": "{ user: { id, email }, token }"
    },
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Processes PDF upload and runs AI matching analysis",
      "requestBodySchema": "{ resumeFile: File, jobDescription: string }",
      "responseBodySchema": "{ scan: { id, matchScore, matchedKeywords, missingSkills } }"
    },
    {
      "path": "/api/v1/scan/history",
      "method": "GET",
      "description": "Retrieves all scan history for current user",
      "responseBodySchema": "{ scans: Scan[] }"
    }
  ],
  "hooks": [
    {
      "name": "useCreateScan",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData (file + jobDescription)",
      "returns": "ScanResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scan/history",
      "params": "none",
      "returns": "Scan[]"
    }
  ]
}