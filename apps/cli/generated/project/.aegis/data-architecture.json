{
  "models": [
    {
      "name": "User",
      "description": "System users with authentication credentials",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        }
      ]
    },
    {
      "name": "ScanResult",
      "description": "Historical analysis results for a resume against a job description",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "jobTitle",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Title of the target role"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Percentage fit score"
        },
        {
          "name": "keywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Identified skill set"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of scan"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" }\n\ndatasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") }\n\nmodel User {\n  id        String       @id @default(uuid())\n  email     String       @unique\n  password  String\n  scans     ScanResult[]\n}\n\nmodel ScanResult {\n  id         String   @id @default(uuid())\n  userId     String\n  user       User     @relation(fields: [userId], references: [id])\n  jobTitle   String\n  matchScore Float\n  keywords   Json\n  createdAt  DateTime @default(now())\n}",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Processes resume upload and job description to calculate match",
      "requestBodySchema": "{ resumeFile: File, jobDescription: string, jobTitle: string }",
      "responseBodySchema": "{ id: string, matchScore: number, keywords: string[] }"
    },
    {
      "path": "/api/v1/scans",
      "method": "GET",
      "description": "Retrieves user scan history",
      "requestBodySchema": "null",
      "responseBodySchema": "ScanResult[]"
    }
  ],
  "hooks": [
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scans",
      "params": "none",
      "returns": "ScanResult[]"
    },
    {
      "name": "usePerformScan",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData",
      "returns": "{ id: string, matchScore: number }"
    }
  ]
}