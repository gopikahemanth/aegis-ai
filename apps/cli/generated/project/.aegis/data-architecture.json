{
  "models": [
    {
      "name": "User",
      "description": "System users for authentication and history management",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique email address"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        }
      ]
    },
    {
      "name": "ScanResult",
      "description": "Stores the outcome of an AI resume analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "jobTitle",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job role"
        },
        {
          "name": "matchPercentage",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated score"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of strings for gaps"
        },
        {
          "name": "rawResumeText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted text content"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "model User {\n  id        String       @id @default(uuid())\n  email     String       @unique\n  password  String\n  scans     ScanResult[]\n}\n\nmodel ScanResult {\n  id              String   @id @default(uuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id])\n  jobTitle        String\n  matchPercentage Float\n  missingKeywords Json\n  rawResumeText   String   @db.Text\n  createdAt       DateTime @default(now())\n}",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Register a new user",
      "requestBodySchema": "{ email: string, password: string }",
      "responseBodySchema": "{ token: string }"
    },
    {
      "path": "/api/v1/analyze",
      "method": "POST",
      "description": "Upload PDF and run NLP analysis",
      "requestBodySchema": "Multipart form data with 'resume' file and 'jobDescription' text",
      "responseBodySchema": "{ id: string, matchPercentage: number, missingKeywords: string[] }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Fetch user scan history",
      "responseBodySchema": "ScanResult[]"
    }
  ],
  "hooks": [
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "void",
      "returns": "ScanResult[]"
    },
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/analyze",
      "params": "formData: FormData",
      "returns": "{ id: string, matchPercentage: number, missingKeywords: string[] }"
    }
  ]
}