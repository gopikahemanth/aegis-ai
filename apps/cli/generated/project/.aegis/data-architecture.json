{
  "models": [
    {
      "name": "User",
      "description": "System user with authentication credentials",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "UUID identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Bcrypt hashed password"
        },
        {
          "name": "resumes",
          "type": "customType",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "Resume",
          "description": "List of uploaded resumes"
        }
      ]
    },
    {
      "name": "Resume",
      "description": "User uploaded PDF document metadata and extracted content",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Resume ID"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the resume"
        },
        {
          "name": "content",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted raw text from PDF"
        },
        {
          "name": "analysisResults",
          "type": "customType",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "AnalysisResult",
          "description": "Associated analysis outcomes"
        }
      ]
    },
    {
      "name": "JobDescription",
      "description": "Target job description details",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Job ID"
        },
        {
          "name": "title",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Job role title"
        },
        {
          "name": "content",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Job description body"
        },
        {
          "name": "analysisResults",
          "type": "customType",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "AnalysisResult",
          "description": "Associated analysis outcomes"
        }
      ]
    },
    {
      "name": "AnalysisResult",
      "description": "Final score and gap breakdown",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Result ID"
        },
        {
          "name": "resumeId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Resume",
          "description": "Source resume"
        },
        {
          "name": "jobDescriptionId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "JobDescription",
          "description": "Target job description"
        },
        {
          "name": "score",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated match percentage"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "JSON array of missing required skills"
        },
        {
          "name": "presentKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "JSON array of matched skills"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" } datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } model User { id String @id @default(uuid()) email String @unique passwordHash String resumes Resume[] } model Resume { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) content String analysisResults AnalysisResult[] } model JobDescription { id String @id @default(uuid()) title String content String analysisResults AnalysisResult[] } model AnalysisResult { id String @id @default(uuid()) resumeId String resume Resume @relation(fields: [resumeId], references: [id]) jobDescriptionId String job JobDescription @relation(fields: [jobDescriptionId], references: [id]) score Float missingKeywords Json presentKeywords Json }",
  "apis": [
    {
      "path": "/api/v1/analyze",
      "method": "POST",
      "description": "Perform gap analysis on uploaded resume and job description",
      "requestBodySchema": "{ resumeId: string, jobDescriptionId: string }",
      "responseBodySchema": "{ score: number, missing: string[], present: string[] }"
    },
    {
      "path": "/api/v1/resume/upload",
      "method": "POST",
      "description": "Upload PDF and parse content",
      "requestBodySchema": "FormData (multipart/form-data)",
      "responseBodySchema": "{ resumeId: string, extractedText: string }"
    }
  ],
  "hooks": [
    {
      "name": "useAnalysis",
      "type": "mutation",
      "endpoint": "/api/v1/analyze",
      "params": "resumeId: string, jobDescriptionId: string",
      "returns": "AnalysisResult"
    },
    {
      "name": "useUploadResume",
      "type": "mutation",
      "endpoint": "/api/v1/resume/upload",
      "params": "file: File",
      "returns": "{ resumeId: string }"
    }
  ]
}