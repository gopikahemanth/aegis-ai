{
  "models": [
    {
      "name": "User",
      "description": "System users for authentication and history tracking",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        },
        {
          "name": "scans",
          "type": "customType",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "Scan",
          "description": "User scan history"
        }
      ]
    },
    {
      "name": "Scan",
      "description": "Historical record of a resume versus job description analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique scan ID"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owning user"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "NLP calculated score"
        },
        {
          "name": "matchedKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of found keywords"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of missing skills"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of scan"
        }
      ]
    }
  ],
  "databaseSchema": "model User {\n  id        String   @id @default(uuid())\n  email     String   @unique\n  password  String\n  scans     Scan[]\n}\n\nmodel Scan {\n  id              String   @id @default(uuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id])\n  matchScore      Float\n  matchedKeywords Json\n  missingKeywords Json\n  createdAt       DateTime @default(now())\n}",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Registers a new user",
      "requestBodySchema": "{ \"email\": \"string\", \"password\": \"string\" }",
      "responseBodySchema": "{ \"userId\": \"string\", \"token\": \"string\" }"
    },
    {
      "path": "/api/v1/scan/analyze",
      "method": "POST",
      "description": "Uploads PDF and JD, parses, and returns match metrics",
      "requestBodySchema": "FormData (resume: File, jobDescription: string)",
      "responseBodySchema": "{ \"matchScore\": \"number\", \"matchedKeywords\": \"string[]\", \"missingKeywords\": \"string[]\" }"
    },
    {
      "path": "/api/v1/scan/history",
      "method": "GET",
      "description": "Retrieves scan history for authenticated user",
      "responseBodySchema": "Scan[]"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/scan/analyze",
      "params": "formData: FormData",
      "returns": "{ matchScore: number, matchedKeywords: string[], missingKeywords: string[] }"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scan/history",
      "params": "userId: string",
      "returns": "Scan[]"
    }
  ]
}