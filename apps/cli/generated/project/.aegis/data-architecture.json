{
  "models": [
    {
      "name": "User",
      "description": "System user account",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User login email"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        }
      ]
    },
    {
      "name": "ResumeScan",
      "description": "Stored analysis session data",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "resumeContent",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted text from resume"
        },
        {
          "name": "jobDescription",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job description text"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated percentage"
        },
        {
          "name": "analysisData",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Detailed gap analysis results"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of scan"
        }
      ]
    }
  ],
  "databaseSchema": "datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } model User { id String @id @default(uuid()) email String @unique password String scans ResumeScan[] } model ResumeScan { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) resumeContent String jobDescription String matchScore Float analysisData Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Registers new user",
      "requestBodySchema": "{ \"email\": \"string\", \"password\": \"string\" }",
      "responseBodySchema": "{ \"token\": \"string\" }"
    },
    {
      "path": "/api/v1/scans",
      "method": "POST",
      "description": "Uploads resume and triggers NLP analysis",
      "requestBodySchema": "{ \"file\": \"Buffer\", \"jobDescription\": \"string\" }",
      "responseBodySchema": "{ \"scanId\": \"string\", \"score\": \"number\", \"details\": \"object\" }"
    },
    {
      "path": "/api/v1/scans",
      "method": "GET",
      "description": "Retrieves scan history",
      "responseBodySchema": "ResumeScan[]"
    },
    {
      "path": "/api/v1/scans/:id",
      "method": "DELETE",
      "description": "Removes a specific scan record",
      "responseBodySchema": "{ \"success\": \"boolean\" }"
    }
  ],
  "hooks": [
    {
      "name": "useResumeScans",
      "type": "query",
      "endpoint": "/api/v1/scans",
      "params": "none",
      "returns": "ResumeScan[]"
    },
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/scans",
      "params": "formData (resume, jobDescription)",
      "returns": "ResumeScan"
    },
    {
      "name": "useDeleteScan",
      "type": "mutation",
      "endpoint": "/api/v1/scans/:id",
      "params": "id: string",
      "returns": "void"
    }
  ]
}