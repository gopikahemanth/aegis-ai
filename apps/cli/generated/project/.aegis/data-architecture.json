{
  "models": [
    {
      "name": "Task",
      "description": "Represents a core unit of work in the Kanban board",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "description": "Unique identifier"
        },
        {
          "name": "title",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "description": "Short summary of the task"
        },
        {
          "name": "description",
          "type": "string",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "description": "Detailed task information"
        },
        {
          "name": "status",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "description": "TaskStatus enum: TODO, IN_PROGRESS, DONE"
        },
        {
          "name": "priority",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "description": "TaskPriority enum: LOW, MEDIUM, HIGH"
        },
        {
          "name": "dueDate",
          "type": "DateTime",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "description": "Deadline for the task"
        },
        {
          "name": "order",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "description": "Position index in Kanban column"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "description": "Timestamp of creation"
        },
        {
          "name": "updatedAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "description": "Last update timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "enum TaskStatus { TODO\nIN_PROGRESS\nDONE }\nenum TaskPriority { LOW\nMEDIUM\nHIGH }\n\nmodel Task {\n  id          String   @id @default(uuid())\n  title       String\n  description String?\n  status      TaskStatus @default(TODO)\n  priority    TaskPriority @default(MEDIUM)\n  dueDate     DateTime?\n  order       Int\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n}",
  "apis": [
    {
      "path": "/api/v1/tasks",
      "method": "GET",
      "description": "Fetch all tasks",
      "responseBodySchema": "{ tasks: Task[] }"
    },
    {
      "path": "/api/v1/tasks",
      "method": "POST",
      "description": "Create a new task",
      "requestBodySchema": "{ title: string, description?: string, priority: string, dueDate?: string }",
      "responseBodySchema": "{ task: Task }"
    },
    {
      "path": "/api/v1/tasks/:id",
      "method": "PATCH",
      "description": "Update task status, order, or details",
      "requestBodySchema": "{ status?: string, order?: number, title?: string, priority?: string, dueDate?: string }",
      "responseBodySchema": "{ task: Task }"
    },
    {
      "path": "/api/v1/tasks/:id",
      "method": "DELETE",
      "description": "Remove a task",
      "responseBodySchema": "{ success: boolean }"
    }
  ],
  "hooks": [
    {
      "name": "useTasks",
      "type": "query",
      "endpoint": "/api/v1/tasks",
      "params": "none",
      "returns": "Task[]"
    },
    {
      "name": "useUpdateTask",
      "type": "mutation",
      "endpoint": "/api/v1/tasks/:id",
      "params": "taskId: string",
      "returns": "Task"
    },
    {
      "name": "useCreateTask",
      "type": "mutation",
      "endpoint": "/api/v1/tasks",
      "params": "none",
      "returns": "Task"
    }
  ]
}