{
  "models": [
    {
      "name": "User",
      "description": "System users for history tracking",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Creation timestamp"
        }
      ]
    },
    {
      "name": "AnalysisReport",
      "description": "Stores final analysis results",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the report"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated percentage"
        },
        {
          "name": "resumeText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Raw resume text"
        },
        {
          "name": "jobDescriptionText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Raw JD text"
        },
        {
          "name": "skillGaps",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Structured JSON of missing skills"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Analysis timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "model User { id String @id @default(uuid()) email String @unique password String createdAt DateTime @default(now()) reports AnalysisReport[] } model AnalysisReport { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) matchScore Float resumeText String jobDescriptionText String skillGaps Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Registers new user",
      "requestBodySchema": "{ email: string, password: string }",
      "responseBodySchema": "{ userId: string, token: string }"
    },
    {
      "path": "/api/v1/analysis",
      "method": "POST",
      "description": "Uploads data and performs NLP analysis",
      "requestBodySchema": "{ resumeFile: File, jobDescription: string }",
      "responseBodySchema": "{ reportId: string, matchScore: number, skillGaps: any }"
    },
    {
      "path": "/api/v1/analysis/history",
      "method": "GET",
      "description": "Fetches user analysis reports",
      "requestBodySchema": "null",
      "responseBodySchema": "AnalysisReport[]"
    }
  ],
  "hooks": [
    {
      "name": "useAnalysisHistory",
      "type": "query",
      "endpoint": "/api/v1/analysis/history",
      "params": "void",
      "returns": "AnalysisReport[]"
    },
    {
      "name": "usePerformAnalysis",
      "type": "mutation",
      "endpoint": "/api/v1/analysis",
      "params": "formData: FormData",
      "returns": "{ reportId: string, matchScore: number }"
    }
  ]
}