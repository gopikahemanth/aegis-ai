{
  "models": [
    {
      "name": "User",
      "description": "System user with authentication credentials",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Login email"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        }
      ]
    },
    {
      "name": "ResumeScan",
      "description": "Historical record of a resume versus job description analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "jobDescription",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Input JD text"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated relevance score"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    },
    {
      "name": "KeywordMatch",
      "description": "Individual keyword analysis results for a specific scan",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "scanId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "ResumeScan",
          "description": "Associated scan"
        },
        {
          "name": "keyword",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "The matched term"
        },
        {
          "name": "isFound",
          "type": "boolean",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Presence in resume"
        }
      ]
    }
  ],
  "databaseSchema": "datasource db { provider = \"postgresql\"; url = env(\"DATABASE_URL\") } generator client { provider = \"prisma-client-js\" } model User { id String @id @default(uuid()); email String @unique; password String; scans ResumeScan[] } model ResumeScan { id String @id @default(uuid()); userId String; user User @relation(fields: [userId], references: [id]); jobDescription String; matchScore Float; createdAt DateTime @default(now()); keywords KeywordMatch[] } model KeywordMatch { id String @id @default(uuid()); scanId String; scan ResumeScan @relation(fields: [scanId], references: [id]); keyword String; isFound Boolean }",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Upload resume PDF and JD, perform NLP analysis, and save result",
      "requestBodySchema": "{ \"jobDescription\": string, \"resumeFile\": File }",
      "responseBodySchema": "{ \"scanId\": string, \"score\": number, \"matches\": Array<{keyword: string, isFound: boolean}> }"
    },
    {
      "path": "/api/v1/scan/:id",
      "method": "GET",
      "description": "Retrieve historical scan detail",
      "responseBodySchema": "{ \"scanId\": string, \"jobDescription\": string, \"matchScore\": number, \"keywords\": Array<{keyword: string, isFound: boolean}> }"
    },
    {
      "path": "/api/v1/scan",
      "method": "GET",
      "description": "List all historical scans for user",
      "responseBodySchema": "Array<{ id: string, matchScore: number, createdAt: string }>"
    }
  ],
  "hooks": [
    {
      "name": "useCreateScan",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData",
      "returns": "ScanResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scan",
      "params": "none",
      "returns": "ScanSummary[]"
    },
    {
      "name": "useScanDetail",
      "type": "query",
      "endpoint": "/api/v1/scan/:id",
      "params": "id: string",
      "returns": "ScanDetail"
    }
  ]
}