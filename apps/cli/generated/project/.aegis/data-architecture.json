{
  "models": [
    {
      "name": "User",
      "description": "Authenticated user accounts",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "description": "Unique identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "description": "User email address"
        },
        {
          "name": "githubToken",
          "type": "string",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "description": "OAuth token for repo access"
        }
      ]
    },
    {
      "name": "Repository",
      "description": "Connected git repositories",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "description": "Unique ID"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "relationTo": "User",
          "description": "Owner"
        },
        {
          "name": "url",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "description": "Repo URL"
        }
      ]
    },
    {
      "name": "Scan",
      "description": "Security analysis execution record",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "description": "Unique ID"
        },
        {
          "name": "repositoryId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "relationTo": "Repository",
          "description": "Target repo"
        },
        {
          "name": "status",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "description": "PENDING, RUNNING, COMPLETED, FAILED"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "description": "Timestamp"
        }
      ]
    },
    {
      "name": "Vulnerability",
      "description": "Detected security issues",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "description": "Unique ID"
        },
        {
          "name": "scanId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "relationTo": "Scan",
          "description": "Scan link"
        },
        {
          "name": "severity",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "description": "CRITICAL, HIGH, MEDIUM, LOW"
        },
        {
          "name": "description",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "description": "Risk detail"
        },
        {
          "name": "lineNumbers",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "description": "Affected lines"
        }
      ]
    },
    {
      "name": "Remediation",
      "description": "Automated fix suggestion",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "description": "Unique ID"
        },
        {
          "name": "vulnerabilityId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "relationTo": "Vulnerability",
          "description": "Related issue"
        },
        {
          "name": "suggestedCode",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "description": "AI-generated patch"
        }
      ]
    }
  ],
  "databaseSchema": "datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } model User { id String @id @default(cuid()) email String @unique repositories Repository[] } model Repository { id String @id @default(cuid()) userId String user User @relation(fields: [userId], references: [id]) url String scans Scan[] } model Scan { id String @id @default(cuid()) repositoryId String repository Repository @relation(fields: [repositoryId], references: [id]) status String createdAt DateTime @default(now()) vulnerabilities Vulnerability[] } model Vulnerability { id String @id @default(cuid()) scanId String scan Scan @relation(fields: [scanId], references: [id]) severity String description String lineNumbers Json remediations Remediation[] } model Remediation { id String @id @default(cuid()) vulnerabilityId String vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id]) suggestedCode String }",
  "apis": [
    {
      "path": "/api/v1/scans",
      "method": "POST",
      "description": "Initiate a new repository scan",
      "requestBodySchema": "{ repositoryId: string }",
      "responseBodySchema": "{ scanId: string, status: string }"
    },
    {
      "path": "/api/v1/scans/:id",
      "method": "GET",
      "description": "Fetch scan results and vulnerabilities",
      "responseBodySchema": "{ id: string, vulnerabilities: Vulnerability[], status: string }"
    }
  ],
  "hooks": [
    {
      "name": "useScanResult",
      "type": "query",
      "endpoint": "/api/v1/scans/:id",
      "params": "scanId: string",
      "returns": "Scan & { vulnerabilities: Vulnerability[] }"
    },
    {
      "name": "useInitiateScan",
      "type": "mutation",
      "endpoint": "/api/v1/scans",
      "params": "repositoryId: string",
      "returns": "{ scanId: string }"
    }
  ]
}