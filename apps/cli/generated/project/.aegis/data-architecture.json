  "databaseSchema": "generator client { provider = \"prisma-client-js\" }\ndatasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") }\n\nmodel User { id String @id @default(uuid()) email String @unique passwordHash String resumes Resume[] }\nmodel Resume { id String @id @default(uuid()) user User @relation(fields: [userId], references: [id]) userId String fileUrl String extractedText String scans ScanResult[] }\nmodel ScanResult { id String @id @default(uuid()) resume Resume @relation(fields: [resumeId], references: [id]) resumeId String jobTitle String matchScore Float matchedKeywords Json missingKeywords Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Upload resume and job text to perform analysis",
      "requestBodySchema": "{ resumeFile: File, jobDescription: string }",
      "responseBodySchema": "{ id: string, matchScore: number, matchedKeywords: string[], missingKeywords: string[] }"
    },
    {
      "path": "/api/v1/scan/:id",
      "method": "GET",
      "description": "Retrieve history of specific scan",
      "responseBodySchema": "ScanResult object"
    }
  ],
  "hooks": [
    {
      "name": "usePerformScan",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData",
      "returns": "ScanResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scan",
      "params": "userId",
      "returns": "ScanResult[]"
    }
  ]
}