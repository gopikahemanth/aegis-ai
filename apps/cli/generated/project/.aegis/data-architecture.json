{
  "models": [
    {
      "name": "User",
      "description": "Authenticated system user",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Encrypted credentials"
        }
      ]
    },
    {
      "name": "AnalysisResult",
      "description": "Stores the outcome of a resume-to-job matching session",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the analysis"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Percentage similarity"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of missing skills"
        },
        {
          "name": "resumeText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Parsed resume content"
        },
        {
          "name": "jobDescription",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job description"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" }\ndatasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") }\n\nmodel User {\n  id           String           @id @default(uuid())\n  email        String           @unique\n  passwordHash String\n  results      AnalysisResult[]\n}\n\nmodel AnalysisResult {\n  id              String   @id @default(uuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id])\n  matchScore      Float\n  missingKeywords Json\n  resumeText      String\n  jobDescription  String\n  createdAt       DateTime @default(now())\n}",
  "apis": [
    {
      "path": "/api/v1/analyze",
      "method": "POST",
      "description": "Upload resume, parse text, and perform semantic keyword matching",
      "requestBodySchema": "{ \"resume\": \"File\", \"jobDescription\": \"string\" }",
      "responseBodySchema": "{ \"id\": \"string\", \"score\": \"number\", \"missingKeywords\": \"string[]\" }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Retrieve historical analysis results for the user",
      "responseBodySchema": "AnalysisResult[]"
    },
    {
      "path": "/api/v1/history/:id",
      "method": "DELETE",
      "description": "Delete a specific historical scan",
      "responseBodySchema": "{ \"success\": \"boolean\" }"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/analyze",
      "params": "formData",
      "returns": "AnalysisResult"
    },
    {
      "name": "useHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "void",
      "returns": "AnalysisResult[]"
    }
  ]
}