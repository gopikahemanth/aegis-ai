{
  "models": [
    {
      "name": "User",
      "description": "System user with authentication credentials",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        }
      ]
    },
    {
      "name": "AnalysisResult",
      "description": "Historical record of a resume-job description scan",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Analysis ID"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the analysis"
        },
        {
          "name": "resumeContent",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted text"
        },
        {
          "name": "jobDescription",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target JD"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated ATS score"
        },
        {
          "name": "keywordDensity",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Detailed frequency map"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "model User { id String @id @default(uuid()) email String @unique password String analyses AnalysisResult[] }\n\nmodel AnalysisResult { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) resumeContent String jobDescription String matchScore Float keywordDensity Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Register new user",
      "requestBodySchema": "{ \"email\": \"string\", \"password\": \"string\" }",
      "responseBodySchema": "{ \"token\": \"string\" }"
    },
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Upload resume, parse, and score against JD",
      "requestBodySchema": "{ \"file\": \"Buffer\", \"jobDescription\": \"string\" }",
      "responseBodySchema": "{ \"score\": \"number\", \"keywords\": \"object\" }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Retrieve past analysis results",
      "requestBodySchema": null,
      "responseBodySchema": "AnalysisResult[]"
    }
  ],
  "hooks": [
    {
      "name": "useScanAnalysis",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData: FormData",
      "returns": "AnalysisResult"
    },
    {
      "name": "useHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "userId: string",
      "returns": "AnalysisResult[]"
    }
  ]
}