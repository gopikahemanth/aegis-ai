{
  "models": [
    {
      "name": "User",
      "description": "System user account for authentication and history tracking",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Secure password hash"
        }
      ]
    },
    {
      "name": "ScanResult",
      "description": "Stores the result of a resume versus job description analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated percentage score"
        },
        {
          "name": "missingSkills",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of identified gaps"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Scan timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "datasource db { provider = \"sqlite\" url = \"file:./dev.db\" } generator client { provider = \"prisma-client-js\" } model User { id String @id @default(uuid()) email String @unique passwordHash String scans ScanResult[] } model ScanResult { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) matchScore Float missingSkills Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Uploads resume and job description to perform NLP analysis and score match",
      "requestBodySchema": "{ resume: File, jobDescription: string }",
      "responseBodySchema": "{ scanId: string, matchScore: number, missingSkills: string[] }"
    },
    {
      "path": "/api/v1/scan/history",
      "method": "GET",
      "description": "Retrieves the historical list of scan results for the authenticated user",
      "responseBodySchema": "{ scans: Array<{id: string, matchScore: number, createdAt: string}> }"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData",
      "returns": "{ data: { matchScore: number, missingSkills: string[] } }"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scan/history",
      "params": "none",
      "returns": "ScanResult[]"
    }
  ]
}