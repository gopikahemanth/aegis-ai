{
  "models": [
    {
      "name": "User",
      "description": "Authenticated system user",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Login email"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Encrypted credentials"
        }
      ]
    },
    {
      "name": "AnalysisResult",
      "description": "Historical record of a resume analysis session",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the record"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated relevance percentage"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of identified keyword gaps"
        },
        {
          "name": "jobTitle",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job title"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of analysis"
        }
      ]
    }
  ],
  "databaseSchema": "datasource db { provider = \"sqlite\" url = \"file:./dev.db\" } generator client { provider = \"prisma-client-js\" } model User { id String @id @default(uuid()) email String @unique passwordHash String analyses AnalysisResult[] } model AnalysisResult { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) matchScore Float missingKeywords Json jobTitle String createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/analyze",
      "method": "POST",
      "description": "Upload resume and job description to perform NLP analysis",
      "requestBodySchema": "{ \"resume\": File, \"jobDescription\": string, \"jobTitle\": string }",
      "responseBodySchema": "{ \"matchScore\": number, \"missingKeywords\": string[], \"id\": string }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Retrieve all past analysis records for the user",
      "responseBodySchema": "AnalysisResult[]"
    },
    {
      "path": "/api/v1/history/:id",
      "method": "DELETE",
      "description": "Delete a specific analysis history item"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/analyze",
      "params": "formData: FormData",
      "returns": "AnalysisResult"
    },
    {
      "name": "useAnalysisHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "none",
      "returns": "AnalysisResult[]"
    }
  ]
}