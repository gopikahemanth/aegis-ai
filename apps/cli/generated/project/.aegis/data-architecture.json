{
  "models": [
    {
      "name": "Task",
      "description": "Represents an individual work unit within the Kanban board.",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "title",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Task summary"
        },
        {
          "name": "description",
          "type": "string",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": null,
          "description": "Detailed task notes"
        },
        {
          "name": "status",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Current board column mapping"
        },
        {
          "name": "priority",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Urgency level: LOW, MEDIUM, HIGH"
        },
        {
          "name": "dueDate",
          "type": "DateTime",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": null,
          "description": "Task deadline"
        },
        {
          "name": "order",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Sorting index in column"
        }
      ]
    },
    {
      "name": "BoardColumn",
      "description": "Defines the Kanban column configuration.",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Column identifier"
        },
        {
          "name": "title",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Display name"
        },
        {
          "name": "order",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Visual position"
        }
      ]
    }
  ],
  "databaseSchema": "model Task {\n  id          String   @id @default(uuid())\n  title       String\n  description String?\n  status      String\n  priority    String\n  dueDate     DateTime?\n  order       Int\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n}\n\nmodel BoardColumn {\n  id    String @id @default(uuid())\n  title String\n  order Int\n}",
  "apis": [
    {
      "path": "/api/v1/tasks",
      "method": "GET",
      "description": "Fetch all tasks for the board",
      "responseBodySchema": "Task[]"
    },
    {
      "path": "/api/v1/tasks",
      "method": "POST",
      "description": "Create a new task",
      "requestBodySchema": "{ title: string, priority: string, status: string, dueDate?: string }",
      "responseBodySchema": "Task"
    },
    {
      "path": "/api/v1/tasks/:id",
      "method": "PATCH",
      "description": "Update task properties (status, order, completion)",
      "requestBodySchema": "{ status?: string, order?: number, title?: string }",
      "responseBodySchema": "Task"
    }
  ],
  "hooks": [
    {
      "name": "useTaskStore",
      "type": "query",
      "endpoint": "/api/v1/tasks",
      "params": "none",
      "returns": "{ tasks: Task[], addTask: (t) => void, moveTask: (id, status, order) => void }"
    },
    {
      "name": "useTaskFilter",
      "type": "query",
      "endpoint": "client-side",
      "params": "tasks: Task[], filter: { status?: string, priority?: string }",
      "returns": "Task[]"
    }
  ]
}