  "databaseSchema": "generator client { provider = \"prisma-client-js\" }\ndatasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") }\n\nmodel User {\n  id        String        @id @default(uuid())\n  email     String        @unique\n  password  String\n  scans     ScanSession[]\n}\n\nmodel ScanSession {\n  id             String         @id @default(uuid())\n  userId         String\n  user           User           @relation(fields: [userId], references: [id])\n  jobDescription String\n  matchScore     Float\n  createdAt      DateTime       @default(now())\n  keywords       KeywordMatch[]\n}\n\nmodel KeywordMatch {\n  id      String      @id @default(uuid())\n  scanId  String\n  scan    ScanSession @relation(fields: [scanId], references: [id])\n  keyword String\n  isFound Boolean\n}",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Upload resume, parse text, analyze against job description",
      "requestBodySchema": "{ \"jobDescription\": string, \"resumeFile\": File }",
      "responseBodySchema": "{ \"scanId\": string, \"score\": number, \"matches\": Array<{keyword: string, isFound: boolean}> }"
    },
    {
      "path": "/api/v1/scan/:id",
      "method": "GET",
      "description": "Retrieve historical scan detail",
      "responseBodySchema": "{ \"scanId\": string, \"matchScore\": number, \"keywords\": Array<{keyword: string, isFound: boolean}> }"
    },
    {
      "path": "/api/v1/scans",
      "method": "GET",
      "description": "Retrieve history list for user",
      "responseBodySchema": "Array<{id: string, matchScore: number, createdAt: string}>"
    },
    {
      "path": "/api/v1/scan/:id",
      "method": "DELETE",
      "description": "Remove a specific scan record",
      "responseBodySchema": "{ \"success\": boolean }"
    }
  ],
  "hooks": [
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scans",
      "params": "none",
      "returns": "ScanSession[]"
    },
    {
      "name": "usePerformScan",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData",
      "returns": "ScanResult"
    },
    {
      "name": "useDeleteScan",
      "type": "mutation",
      "endpoint": "/api/v1/scan/:id",
      "params": "scanId: string",
      "returns": "void"
    }
  ]
}