{
  "models": [
    {
      "name": "User",
      "description": "System users for persistence and history tracking",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique email for auth"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        },
        {
          "name": "submissions",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Submission",
          "description": "User scan history"
        }
      ]
    },
    {
      "name": "Submission",
      "description": "Individual resume analysis request",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owning user"
        },
        {
          "name": "jobTitle",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job title"
        },
        {
          "name": "resumeText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted text content"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        },
        {
          "name": "result",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "AnalysisResult",
          "description": "Computed analysis"
        }
      ]
    },
    {
      "name": "AnalysisResult",
      "description": "Computed metrics from NLP scan",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "submissionId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": "Submission",
          "description": "Owning submission"
        },
        {
          "name": "score",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Match percentage"
        },
        {
          "name": "matchedKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of found keywords"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of missing keywords"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" } datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } model User { id String @id @default(uuid()) email String @unique password String submissions Submission[] } model Submission { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) jobTitle String resumeText String createdAt DateTime @default(now()) result AnalysisResult? } model AnalysisResult { id String @id @default(uuid()) submissionId String @unique submission Submission @relation(fields: [submissionId], references: [id]) score Float matchedKeywords Json missingKeywords Json }",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Upload PDF and Job Desc for analysis",
      "requestBodySchema": "{ \"file\": File, \"jobDescription\": string }",
      "responseBodySchema": "{ \"score\": number, \"matched\": string[], \"missing\": string[] }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Retrieve user scan history",
      "responseBodySchema": "Submission[]"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData (file, jobDescription)",
      "returns": "AnalysisResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "none",
      "returns": "Submission[]"
    }
  ]
}