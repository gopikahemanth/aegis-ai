{
  "models": [
    {
      "name": "User",
      "description": "Authenticated system user",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User login email"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed credentials"
        }
      ]
    },
    {
      "name": "JobDescription",
      "description": "Target job description metadata",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "title",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Job title"
        },
        {
          "name": "content",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Full job description text"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner"
        }
      ]
    },
    {
      "name": "ResumeScan",
      "description": "Core analysis entity linking resume and JD",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner"
        },
        {
          "name": "jobDescriptionId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "JobDescription",
          "description": "Linked JD"
        },
        {
          "name": "resumeText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted text content"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated score"
        },
        {
          "name": "analysisData",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Detailed AI insight report"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "model User { id String @id @default(uuid()) email String @unique password String resumes ResumeScan[] jds JobDescription[] } model JobDescription { id String @id @default(uuid()) title String content String userId String user User @relation(fields: [userId], references: [id]) scans ResumeScan[] } model ResumeScan { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) jobDescriptionId String jd JobDescription @relation(fields: [jobDescriptionId], references: [id]) resumeText String matchScore Float analysisData Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/scans",
      "method": "POST",
      "description": "Upload and perform analysis",
      "requestBodySchema": "{ resumeFile: File, jobDescription: string }",
      "responseBodySchema": "{ id: string, matchScore: number, analysisData: object }"
    },
    {
      "path": "/api/v1/scans",
      "method": "GET",
      "description": "List history",
      "responseBodySchema": "ResumeScan[]"
    },
    {
      "path": "/api/v1/scans/:id",
      "method": "GET",
      "description": "Fetch specific report",
      "responseBodySchema": "ResumeScan"
    }
  ],
  "hooks": [
    {
      "name": "useCreateScan",
      "type": "mutation",
      "endpoint": "/api/v1/scans",
      "params": "formData",
      "returns": "ScanResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scans",
      "params": "void",
      "returns": "ResumeScan[]"
    }
  ]
}