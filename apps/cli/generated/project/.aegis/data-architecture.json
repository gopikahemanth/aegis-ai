{
  "models": [
    {
      "name": "User",
      "description": "User authentication and profile management",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        },
        {
          "name": "scans",
          "type": "customType",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "AnalysisResult",
          "description": "Related analysis results"
        }
      ]
    },
    {
      "name": "AnalysisResult",
      "description": "Historical resume-to-job matching analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Percentage score"
        },
        {
          "name": "matchedKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of found keywords"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of missing keywords"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" }\ndatasource db { provider = \"sqlite\" url = \"file:./dev.db\" }\n\nmodel User {\n  id        String   @id @default(uuid())\n  email     String   @unique\n  password  String\n  scans     AnalysisResult[]\n}\n\nmodel AnalysisResult {\n  id              String   @id @default(uuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id])\n  matchScore      Float\n  matchedKeywords String\n  missingKeywords String\n  createdAt       DateTime @default(now())\n}",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Registers a new user",
      "requestBodySchema": "{ \"email\": \"string\", \"password\": \"string\" }",
      "responseBodySchema": "{ \"token\": \"string\" }"
    },
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Uploads PDF and JD, performs NLP analysis",
      "requestBodySchema": "{ \"resume\": \"FormData (binary)\", \"jobDescription\": \"string\" }",
      "responseBodySchema": "{ \"matchScore\": \"number\", \"matchedKeywords\": \"string[]\", \"missingKeywords\": \"string[]\" }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Retrieves user application history",
      "requestBodySchema": "null",
      "responseBodySchema": "AnalysisResult[]"
    }
  ],
  "hooks": [
    {
      "name": "useScanAnalysis",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData: FormData",
      "returns": "AnalysisResult"
    },
    {
      "name": "useHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "none",
      "returns": "AnalysisResult[]"
    }
  ]
}