{
  "models": [
    {
      "name": "User",
      "description": "System user authentication and profile storage",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Encrypted password"
        }
      ]
    },
    {
      "name": "ScanResult",
      "description": "Container for a single resume analysis event",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "resumeText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted resume content"
        },
        {
          "name": "jobDescriptionText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job description"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated compatibility percentage"
        },
        {
          "name": "analysisData",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Structured breakdown of keywords and gaps"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of creation"
        }
      ]
    }
  ],
  "databaseSchema": "model User { id String @id @default(uuid()) email String @unique passwordHash String scans ScanResult[] }\n\nmodel ScanResult { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) resumeText String jobDescriptionText String matchScore Float analysisData Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/scans",
      "method": "POST",
      "description": "Upload resume/JD, trigger parsing and analysis",
      "requestBodySchema": "{ \"resume\": \"File\", \"jobDescription\": \"string\" }",
      "responseBodySchema": "{ \"id\": \"string\", \"matchScore\": \"number\", \"analysis\": \"object\" }"
    },
    {
      "path": "/api/v1/scans",
      "method": "GET",
      "description": "Fetch user scan history",
      "responseBodySchema": "ScanResult[]"
    },
    {
      "path": "/api/v1/scans/:id",
      "method": "DELETE",
      "description": "Remove a specific scan record",
      "responseBodySchema": "{ \"success\": \"boolean\" }"
    }
  ],
  "hooks": [
    {
      "name": "useCreateScan",
      "type": "mutation",
      "endpoint": "/api/v1/scans",
      "params": "formData (resume, jobDescription)",
      "returns": "ScanResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scans",
      "params": "none",
      "returns": "ScanResult[]"
    }
  ]
}