{
  "models": [
    {
      "name": "User",
      "description": "System user with authentication credentials",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Encrypted password"
        },
        {
          "name": "scans",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Scan",
          "description": "User history"
        }
      ]
    },
    {
      "name": "Scan",
      "description": "Historical scan sessions linking resume and job data",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Scan unique id"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "jobDescription",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job requirements"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        },
        {
          "name": "result",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Analyzed match metadata"
        }
      ]
    }
  ],
  "databaseSchema": "model User {\n  id        String   @id @default(uuid())\n  email     String   @unique\n  password  String\n  scans     Scan[]\n}\n\nmodel Scan {\n  id             String   @id @default(uuid())\n  userId         String\n  user           User     @relation(fields: [userId], references: [id])\n  jobDescription String\n  createdAt      DateTime @default(now())\n  result         Json\n}",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Upload resume, perform analysis, and store result",
      "requestBodySchema": "{ \"jobDescription\": \"string\", \"resumeFile\": \"Buffer\" }",
      "responseBodySchema": "{ \"scanId\": \"string\", \"matchScore\": \"number\", \"keywords\": \"array\" }"
    },
    {
      "path": "/api/v1/scans",
      "method": "GET",
      "description": "Retrieve all scans for the authenticated user",
      "responseBodySchema": "Array<{ id: string, createdAt: string, result: object }>"
    },
    {
      "path": "/api/v1/scans/:id",
      "method": "DELETE",
      "description": "Remove historical scan record",
      "responseBodySchema": "{ \"status\": \"success\" }"
    }
  ],
  "hooks": [
    {
      "name": "useCreateScan",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData",
      "returns": "ScanResult"
    },
    {
      "name": "useGetScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scans",
      "params": "void",
      "returns": "Scan[]"
    },
    {
      "name": "useDeleteScan",
      "type": "mutation",
      "endpoint": "/api/v1/scans/:id",
      "params": "id: string",
      "returns": "void"
    }
  ]
}