{
  "models": [
    {
      "name": "User",
      "description": "System user with authentication credentials",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Login email"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        },
        {
          "name": "scans",
          "type": "customType",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "ScanResult",
          "description": "User history"
        }
      ]
    },
    {
      "name": "ScanResult",
      "description": "Historical record of a resume-job match analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "score",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated match percentage"
        },
        {
          "name": "matchedKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of keywords found"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of keywords missing"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of scan"
        }
      ]
    }
  ],
  "databaseSchema": "model User { id String @id @default(uuid()) email String @unique password String scans ScanResult[] } model ScanResult { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) score Float matchedKeywords Json missingKeywords Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Register new user",
      "requestBodySchema": "{ \"email\": \"string\", \"password\": \"string\" }",
      "responseBodySchema": "{ \"token\": \"string\" }"
    },
    {
      "path": "/api/v1/scans",
      "method": "POST",
      "description": "Upload resume, parse, and analyze against job description",
      "requestBodySchema": "{ \"resumeFile\": \"File\", \"jobDescription\": \"string\" }",
      "responseBodySchema": "{ \"score\": \"number\", \"matched\": \"string[]\", \"missing\": \"string[]\" }"
    },
    {
      "path": "/api/v1/scans/history",
      "method": "GET",
      "description": "Fetch user scan history",
      "responseBodySchema": "ScanResult[]"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/scans",
      "params": "formData: FormData",
      "returns": "{ score: number, matched: string[], missing: string[] }"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scans/history",
      "params": "none",
      "returns": "ScanResult[]"
    }
  ]
}