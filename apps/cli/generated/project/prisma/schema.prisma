generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
}

model Artwork {
  id          Int      @id @default(autoincrement())
  title       String
  artist      String
  description String
  imageUrl    String
  category    String
  createdAt   DateTime @default(now())
}