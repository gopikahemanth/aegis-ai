        }
      ]
    },
    {
      "name": "Pairing",
      "description": "Historical link between a resume and a job description with analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
