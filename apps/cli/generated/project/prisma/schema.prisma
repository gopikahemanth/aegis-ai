generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Artwork {
  id          Int      @id @default(autoincrement())
  title       String
  artistName  String
  description String
  imageUrl    String
  price       Float
  category    String
  createdAt   DateTime @default(now())
}