{
  "models": [
    {
      "name": "User",
      "description": "System users for authentication and task assignment",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "name",
          "type": "string",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": null,
          "description": "User full name"
        },
        {
          "name": "tasks",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Task",
          "description": "Tasks assigned to user"
        }
      ]
    },
    {
      "name": "Board",
      "description": "Container for Kanban columns",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Board ID"
        },
        {
          "name": "title",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Board title"
        },
        {
          "name": "columns",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Column",
          "description": "Columns belonging to board"
        }
      ]
    },
    {
      "name": "Column",
      "description": "Kanban columns representing task status",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Column ID"
        },
        {
          "name": "title",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Display name"
        },
        {
          "name": "boardId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Board",
          "description": "Parent board reference"
        },
        {
          "name": "tasks",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Task",
          "description": "Tasks in this column"
        }
      ]
    },
    {
      "name": "Task",
      "description": "Individual work items",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Task ID"
        },
        {
          "name": "title",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Task summary"
        },
        {
          "name": "description",
          "type": "string",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": null,
          "description": "Detailed notes"
        },
        {
          "name": "priority",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "LOW | MEDIUM | HIGH | URGENT"
        },
        {
          "name": "columnId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Column",
          "description": "Parent column"
        },
        {
          "name": "assigneeId",
          "type": "string",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "User",
          "description": "Assigned user"
        },
        {
          "name": "order",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Sort index"
        }
      ]
    }
  ],
  "databaseSchema": "model User { id String @id @default(uuid()); email String @unique; name String?; tasks Task[] } model Board { id String @id @default(uuid()); title String; columns Column[] } model Column { id String @id @default(uuid()); title String; boardId String; board Board @relation(fields: [boardId], references: [id]); tasks Task[] } model Task { id String @id @default(uuid()); title String; description String?; priority String; columnId String; column Column @relation(fields: [columnId], references: [id]); assigneeId String?; assignee User? @relation(fields: [assigneeId], references: [id]); order Int }",
  "apis": [
    {
      "path": "/api/v1/tasks",
      "method": "GET",
      "description": "Fetch all tasks for the board",
      "responseBodySchema": "Task[]"
    },
    {
      "path": "/api/v1/tasks",
      "method": "POST",
      "description": "Create a new task",
      "requestBodySchema": "{ title: string, priority: string, columnId: string, assigneeId?: string }",
      "responseBodySchema": "Task"
    },
    {
      "path": "/api/v1/tasks/[id]",
      "method": "PATCH",
      "description": "Update task status or details",
      "requestBodySchema": "{ columnId?: string, order?: number, priority?: string, assigneeId?: string }",
      "responseBodySchema": "Task"
    }
  ],
  "hooks": [
    {
      "name": "useTasks",
      "type": "query",
      "endpoint": "/api/v1/tasks",
      "params": "none",
      "returns": "Task[]"
    },
    {
      "name": "useUpdateTask",
      "type": "mutation",
      "endpoint": "/api/v1/tasks/[id]",
      "params": "id: string",
      "returns": "void"
    }
  ]
}