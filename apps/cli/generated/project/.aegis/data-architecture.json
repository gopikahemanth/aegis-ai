{
  "models": [
    {
      "name": "User",
      "description": "System users for history tracking",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "UUID"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        }
      ]
    },
    {
      "name": "ScanResult",
      "description": "Persistence of AI-analyzed resume results",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "UUID"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Percentage similarity"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of missing keywords"
        },
        {
          "name": "resumeText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted resume content"
        },
        {
          "name": "jobDescriptionText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted job content"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Scan timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" }\ndatasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") }\n\nmodel User {\n  id String @id @default(uuid())\n  email String @unique\n  passwordHash String\n  scans ScanResult[]\n}\n\nmodel ScanResult {\n  id String @id @default(uuid())\n  userId String\n  user User @relation(fields: [userId], references: [id])\n  matchScore Float\n  missingKeywords Json\n  resumeText String\n  jobDescriptionText String\n  createdAt DateTime @default(now())\n}",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Uploads PDF files, performs extraction and semantic keyword analysis",
      "requestBodySchema": "multipart/form-data with resume and jobDescription pdfs",
      "responseBodySchema": "{ id: string, matchScore: number, missingKeywords: string[] }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Retrieves historical scan results for the authenticated user",
      "responseBodySchema": "ScanResult[]"
    },
    {
      "path": "/api/v1/export",
      "method": "GET",
      "description": "Generates downloadable report for a specific scan ID",
      "requestBodySchema": null,
      "responseBodySchema": "PDF or CSV file stream"
    }
  ],
  "hooks": [
    {
      "name": "useScanResult",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData (resume, jobDescription)",
      "returns": "ScanResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "userId: string",
      "returns": "ScanResult[]"
    }
  ]
}