{
  "models": [
    {
      "name": "User",
      "description": "System authentication entity",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email"
        },
        {
          "name": "analyses",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Analysis",
          "description": "One-to-many relationship"
        }
      ]
    },
    {
      "name": "Analysis",
      "description": "Primary record of a resume scan",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner ID"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Overall similarity percentage"
        },
        {
          "name": "keywordsFound",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of matched keywords"
        },
        {
          "name": "resumeText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted resume content"
        },
        {
          "name": "jobDescriptionText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job requirements"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } model User { id String @id @default(cuid()) email String @unique analyses Analysis[] } model Analysis { id String @id @default(cuid()) userId String user User @relation(fields: [userId], references: [id]) matchScore Float keywordsFound Json resumeText String jobDescriptionText String createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/analyses",
      "method": "POST",
      "description": "Processes PDF and Job Description to store a new analysis",
      "requestBodySchema": "{ resumeFile: File, jobDescription: string }",
      "responseBodySchema": "{ id: string, matchScore: number, keywordsFound: string[] }"
    },
    {
      "path": "/api/v1/analyses",
      "method": "GET",
      "description": "Retrieves historical analysis logs",
      "requestBodySchema": null,
      "responseBodySchema": "Analysis[]"
    },
    {
      "path": "/api/v1/analyses/[id]",
      "method": "DELETE",
      "description": "Removes a specific analysis record",
      "requestBodySchema": null,
      "responseBodySchema": "{ success: boolean }"
    }
  ],
  "hooks": [
    {
      "name": "useCreateAnalysis",
      "type": "mutation",
      "endpoint": "/api/v1/analyses",
      "params": "formData: FormData",
      "returns": "Analysis"
    },
    {
      "name": "useAnalysisHistory",
      "type": "query",
      "endpoint": "/api/v1/analyses",
      "params": "none",
      "returns": "Analysis[]"
    }
  ]
}