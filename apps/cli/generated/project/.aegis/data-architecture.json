{
  "models": [
    {
      "name": "User",
      "description": "Authenticated system user",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User login email"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        }
      ]
    },
    {
      "name": "ScanResult",
      "description": "Historical record of a resume analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated percentage score"
        },
        {
          "name": "matchedKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of strings found in both"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of missing required skills"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" } datasource db { provider = \"sqlite\" url = \"file:./dev.db\" } model User { id String @id @default(uuid()) email String @unique password String scans ScanResult[] } model ScanResult { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) matchScore Float matchedKeywords String missingKeywords String createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Uploads files and triggers the analysis engine",
      "requestBodySchema": "FormData: { resume: File, jobDescription: string }",
      "responseBodySchema": "{ id: string, matchScore: number, matchedKeywords: string[], missingKeywords: string[] }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Retrieves historical scan results for current user",
      "responseBodySchema": "ScanResult[]"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData: FormData",
      "returns": "ScanResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "none",
      "returns": "ScanResult[]"
    }
  ]
}