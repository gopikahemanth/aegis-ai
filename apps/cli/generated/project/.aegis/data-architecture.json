{
  "models": [
    {
      "name": "User",
      "description": "System user with authentication",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Login email"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        }
      ]
    },
    {
      "name": "Analysis",
      "description": "Historical record of an analysis session",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Analysis primary key"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the analysis"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated percentage"
        },
        {
          "name": "jobTitle",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Job title target"
        },
        {
          "name": "results",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Detailed analysis metrics"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" }\ndatasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") }\n\nmodel User {\n  id        String     @id @default(uuid())\n  email     String     @unique\n  password  String\n  analyses  Analysis[]\n}\n\nmodel Analysis {\n  id         String   @id @default(uuid())\n  userId     String\n  user       User     @relation(fields: [userId], references: [id])\n  matchScore Float\n  jobTitle   String\n  results    Json\n  createdAt  DateTime @default(now())\n}",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Registers a new user",
      "requestBodySchema": "{ email: string, password: string }",
      "responseBodySchema": "{ token: string }"
    },
    {
      "path": "/api/v1/analyze",
      "method": "POST",
      "description": "Uploads resume/job details and performs AI analysis",
      "requestBodySchema": "FormData (resume: File, jobDescription: string)",
      "responseBodySchema": "{ score: number, gaps: string[], analysisId: string }"
    },
    {
      "path": "/api/v1/history",
      "method": "GET",
      "description": "Fetches current user analysis history",
      "responseBodySchema": "Analysis[]"
    }
  ],
  "hooks": [
    {
      "name": "useAnalysisHistory",
      "type": "query",
      "endpoint": "/api/v1/history",
      "params": "none",
      "returns": "Analysis[]"
    },
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/analyze",
      "params": "formData: FormData",
      "returns": "{ score: number, gaps: string[] }"
    }
  ]
}