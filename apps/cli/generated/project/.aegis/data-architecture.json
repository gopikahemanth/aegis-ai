{
  "models": [
    {
      "name": "User",
      "description": "System users with hashed credentials",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "UUID primary key"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Bcrypt hashed password"
        },
        {
          "name": "scans",
          "type": "customType",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "ResumeScan",
          "description": "Relation to history"
        }
      ]
    },
    {
      "name": "ResumeScan",
      "description": "Stores individual analysis results and metadata",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "UUID"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner ID"
        },
        {
          "name": "jobTitle",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job title"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated similarity percentage"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "JSON array of missing terms"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } model User { id String @id @default(uuid()) email String @unique password String scans ResumeScan[] } model ResumeScan { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) jobTitle String matchScore Float missingKeywords Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Registers new user",
      "requestBodySchema": "{ email: string, password: string }",
      "responseBodySchema": "{ token: string }"
    },
    {
      "path": "/api/v1/scan/analyze",
      "method": "POST",
      "description": "Uploads PDF and job description for analysis",
      "requestBodySchema": "Multipart form data with 'resume' file and 'jobDescription' string",
      "responseBodySchema": "{ scanId: string, matchScore: number, missingKeywords: string[] }"
    },
    {
      "path": "/api/v1/scan/history",
      "method": "GET",
      "description": "Fetches user scan history",
      "responseBodySchema": "ResumeScan[]"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/scan/analyze",
      "params": "formData (file + jobDescription)",
      "returns": "analysisResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scan/history",
      "params": "none",
      "returns": "ResumeScan[]"
    }
  ]
}