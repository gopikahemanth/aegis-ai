{
  "models": [
    {
      "name": "User",
      "description": "System user with authentication credentials",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User login email"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Bcrypt hashed password"
        },
        {
          "name": "resumeScans",
          "type": "customType",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "ResumeScan",
          "description": "Related history of scans"
        }
      ]
    },
    {
      "name": "ResumeScan",
      "description": "Historical record of a resume versus job description analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated percentage match"
        },
        {
          "name": "matchedKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of found keywords"
        },
        {
          "name": "missingSkills",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of missing required skills"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of creation"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" } datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } model User { id String @id @default(uuid()) email String @unique passwordHash String scans ResumeScan[] } model ResumeScan { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) matchScore Float matchedKeywords Json missingSkills Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Register a new user",
      "requestBodySchema": "{ email: string, password: string }",
      "responseBodySchema": "{ token: string, user: { id: string, email: string } }"
    },
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Upload resume, parse, and analyze against job description",
      "requestBodySchema": "FormData (pdf file, jobDescription text)",
      "responseBodySchema": "{ scanId: string, matchScore: number, matchedKeywords: string[], missingSkills: string[] }"
    },
    {
      "path": "/api/v1/scan/history",
      "method": "GET",
      "description": "Fetch current user scan history",
      "requestBodySchema": "null",
      "responseBodySchema": "ResumeScan[]"
    }
  ],
  "hooks": [
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData (file, description)",
      "returns": "ScanResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scan/history",
      "params": "none",
      "returns": "ResumeScan[]"
    }
  ]
}