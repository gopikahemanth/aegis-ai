{
  "models": [
    {
      "name": "User",
      "description": "System user with authentication",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "UUID identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Email for login"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        }
      ]
    },
    {
      "name": "ScanResult",
      "description": "Historical scan analysis report",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "jobTitle",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job role"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated percentage"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of missing skills"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" } datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } model User { id String @id @default(uuid()) email String @unique password String scans ScanResult[] } model ScanResult { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) jobTitle String matchScore Float missingKeywords Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Register new user",
      "requestBodySchema": "{ \"email\": \"string\", \"password\": \"string\" }",
      "responseBodySchema": "{ \"token\": \"string\" }"
    },
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Process resume and job description via NLP",
      "requestBodySchema": "Multipart FormData containing pdf file and jobDescription text",
      "responseBodySchema": "{ \"id\": \"string\", \"matchScore\": \"number\", \"missingKeywords\": \"string[]\" }"
    },
    {
      "path": "/api/v1/scans",
      "method": "GET",
      "description": "Fetch user scan history",
      "requestBodySchema": null,
      "responseBodySchema": "ScanResult[]"
    }
  ],
  "hooks": [
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scans",
      "params": "none",
      "returns": "ScanResult[]"
    },
    {
      "name": "useAnalyzeResume",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData",
      "returns": "{ matchScore: number, missingKeywords: string[] }"
    }
  ]
}