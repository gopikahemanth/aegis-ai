{
  "models": [
    {
      "name": "User",
      "description": "System users with authentication credentials",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Bcrypt hashed password"
        },
        {
          "name": "resumes",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Resume",
          "description": "User's uploaded resumes"
        }
      ]
    },
    {
      "name": "Resume",
      "description": "Stored PDF resume files and extracted text",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the resume"
        },
        {
          "name": "rawText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted text content"
        },
        {
          "name": "fileName",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Original file name"
        },
        {
          "name": "scans",
          "type": "customType",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "ScanResult",
          "description": "Historical scans"
        }
      ]
    },
    {
      "name": "ScanResult",
      "description": "Evaluation metrics of a resume against a job description",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "resumeId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "Resume",
          "description": "Linked resume"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated Jaccard/Cosine score"
        },
        {
          "name": "matchedKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "JSON array of found keywords"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "JSON array of missing keywords"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of analysis"
        }
      ]
    }
  ],
  "databaseSchema": "datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } model User { id String @id @default(uuid()) email String @unique passwordHash String resumes Resume[] } model Resume { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) rawText String fileName String scans ScanResult[] } model ScanResult { id String @id @default(uuid()) resumeId String resume Resume @relation(fields: [resumeId], references: [id]) matchScore Float matchedKeywords Json missingKeywords Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/resumes",
      "method": "POST",
      "description": "Uploads a PDF, parses text, and saves to database",
      "requestBodySchema": "{ file: FormData, userId: string }",
      "responseBodySchema": "{ id: string, fileName: string }"
    },
    {
      "path": "/api/v1/scans",
      "method": "POST",
      "description": "Analyzes resume against job description",
      "requestBodySchema": "{ resumeId: string, jobDescription: string }",
      "responseBodySchema": "{ id: string, matchScore: number, matchedKeywords: string[], missingKeywords: string[] }"
    },
    {
      "path": "/api/v1/scans/history",
      "method": "GET",
      "description": "Retrieves scan history for a user",
      "responseBodySchema": "ScanResult[]"
    }
  ],
  "hooks": [
    {
      "name": "useResumeUpload",
      "type": "mutation",
      "endpoint": "/api/v1/resumes",
      "params": "file: File",
      "returns": "Resume"
    },
    {
      "name": "useAnalyzeJobMatch",
      "type": "mutation",
      "endpoint": "/api/v1/scans",
      "params": "resumeId: string, jobDescription: string",
      "returns": "ScanResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scans/history",
      "params": "userId: string",
      "returns": "ScanResult[]"
    }
  ]
}