{
  "models": [
    {
      "name": "User",
      "description": "System users for authentication and history scoping",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User login email"
        },
        {
          "name": "password",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Hashed password"
        },
        {
          "name": "scans",
          "type": "customType",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "ResumeScan",
          "description": "User resume history"
        }
      ]
    },
    {
      "name": "ResumeScan",
      "description": "Stores individual resume scan results and metadata",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary key"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "fileName",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Source filename"
        },
        {
          "name": "jobDescription",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Reference job text"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated percentage"
        },
        {
          "name": "keywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "JSON object of matched/missing keywords"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp"
        }
      ]
    }
  ],
  "databaseSchema": "datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } \n\n model User { id String @id @default(uuid()) email String @unique password String scans ResumeScan[] } \n\n model ResumeScan { id String @id @default(uuid()) userId String user User @relation(fields: [userId], references: [id]) fileName String jobDescription String matchScore Float keywords Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/scans",
      "method": "POST",
      "description": "Upload resume, perform extraction, calculate NLP score and save to DB",
      "requestBodySchema": "{ \"file\": \"blob\", \"jobDescription\": \"string\" }",
      "responseBodySchema": "{ \"scanId\": \"string\", \"matchScore\": \"number\", \"keywords\": \"object\" }"
    },
    {
      "path": "/api/v1/scans",
      "method": "GET",
      "description": "Retrieve all scans for the authenticated user",
      "responseBodySchema": "ResumeScan[]"
    },
    {
      "path": "/api/v1/scans/:id",
      "method": "GET",
      "description": "Get detailed breakdown of a specific scan",
      "responseBodySchema": "ResumeScan"
    }
  ],
  "hooks": [
    {
      "name": "useCreateScan",
      "type": "mutation",
      "endpoint": "/api/v1/scans",
      "params": "FormData (file, jobDescription)",
      "returns": "ResumeScan"
    },
    {
      "name": "useUserScans",
      "type": "query",
      "endpoint": "/api/v1/scans",
      "params": "none",
      "returns": "ResumeScan[]"
    },
    {
      "name": "useScanDetails",
      "type": "query",
      "endpoint": "/api/v1/scans/:id",
      "params": "scanId: string",
      "returns": "ResumeScan"
    }
  ]
}