{
  "models": [
    {
      "name": "User",
      "description": "System users for authentication and data isolation",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary user identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "passwordHash",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Bcrypt hashed password"
        },
        {
          "name": "scans",
          "type": "customType",
          "isId": false,
          "isNullable": true,
          "isUnique": false,
          "relationTo": "Scan",
          "description": "One-to-many relationship with scans"
        }
      ]
    },
    {
      "name": "Scan",
      "description": "Stores the result and metadata of a resume vs job description analysis",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Primary scan identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the scan"
        },
        {
          "name": "matchScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated cosine similarity score"
        },
        {
          "name": "matchedKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of found keywords"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "List of identified gaps"
        },
        {
          "name": "jobTitle",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job title for context"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of analysis"
        }
      ]
    }
  ],
  "databaseSchema": "model User {\n  id        String   @id @default(uuid())\n  email     String   @unique\n  password  String\n  scans     Scan[]\n  createdAt DateTime @default(now())\n}\n\nmodel Scan {\n  id              String   @id @default(uuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id])\n  matchScore      Float\n  matchedKeywords Json\n  missingKeywords Json\n  jobTitle        String\n  createdAt       DateTime @default(now())\n}",
  "apis": [
    {
      "path": "/api/v1/auth/register",
      "method": "POST",
      "description": "Registers a new user",
      "requestBodySchema": "{ email, password }",
      "responseBodySchema": "{ token, user }"
    },
    {
      "path": "/api/v1/scan",
      "method": "POST",
      "description": "Uploads resume and JD to perform NLP match analysis",
      "requestBodySchema": "FormData (resume: File, jobDescription: string, jobTitle: string)",
      "responseBodySchema": "{ scanId, matchScore, matchedKeywords, missingKeywords }"
    },
    {
      "path": "/api/v1/scan/history",
      "method": "GET",
      "description": "Retrieves scan history for authenticated user",
      "responseBodySchema": "Scan[]"
    }
  ],
  "hooks": [
    {
      "name": "usePerformScan",
      "type": "mutation",
      "endpoint": "/api/v1/scan",
      "params": "formData: FormData",
      "returns": "ScanResult"
    },
    {
      "name": "useScanHistory",
      "type": "query",
      "endpoint": "/api/v1/scan/history",
      "params": "void",
      "returns": "Scan[]"
    }
  ]
}