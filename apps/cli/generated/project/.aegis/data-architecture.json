{
  "models": [
    {
      "name": "User",
      "description": "System user with authentication details",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "email",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "User email address"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Account creation timestamp"
        }
      ]
    },
    {
      "name": "Analysis",
      "description": "Record of a resume versus job description analysis session",
      "persistence": "database",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "isId": true,
          "isNullable": false,
          "isUnique": true,
          "relationTo": null,
          "description": "Unique identifier"
        },
        {
          "name": "userId",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": "User",
          "description": "Owner of the analysis"
        },
        {
          "name": "resumeText",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Extracted resume content"
        },
        {
          "name": "jobDescription",
          "type": "string",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Target job description text"
        },
        {
          "name": "relevanceScore",
          "type": "number",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Calculated score 0-100"
        },
        {
          "name": "missingKeywords",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Array of missing high-value keywords"
        },
        {
          "name": "suggestions",
          "type": "Json",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Actionable feedback from LLM"
        },
        {
          "name": "createdAt",
          "type": "DateTime",
          "isId": false,
          "isNullable": false,
          "isUnique": false,
          "relationTo": null,
          "description": "Timestamp of analysis"
        }
      ]
    }
  ],
  "databaseSchema": "generator client { provider = \"prisma-client-js\" } datasource db { provider = \"postgresql\" url = env(\"DATABASE_URL\") } model User { id String @id @default(cuid()) email String @unique createdAt DateTime @default(now()) analyses Analysis[] } model Analysis { id String @id @default(cuid()) userId String user User @relation(fields: [userId], references: [id]) resumeText String jobDescription String relevanceScore Float missingKeywords Json suggestions Json createdAt DateTime @default(now()) }",
  "apis": [
    {
      "path": "/api/v1/analyses",
      "method": "POST",
      "description": "Uploads PDF and JD to generate analysis",
      "requestBodySchema": "{ \"pdfBuffer\": \"base64\", \"jobDescription\": \"string\" }",
      "responseBodySchema": "{ \"id\": \"string\", \"relevanceScore\": \"number\", \"missingKeywords\": \"string[]\", \"suggestions\": \"object\" }"
    },
    {
      "path": "/api/v1/analyses",
      "method": "GET",
      "description": "Retrieves analysis history for authenticated user",
      "responseBodySchema": "Analysis[]"
    },
    {
      "path": "/api/v1/analyses/:id",
      "method": "GET",
      "description": "Retrieves single analysis result",
      "responseBodySchema": "Analysis"
    }
  ],
  "hooks": [
    {
      "name": "useCreateAnalysis",
      "type": "mutation",
      "endpoint": "/api/v1/analyses",
      "params": "none",
      "returns": "Analysis"
    },
    {
      "name": "useAnalysisHistory",
      "type": "query",
      "endpoint": "/api/v1/analyses",
      "params": "none",
      "returns": "Analysis[]"
    }
  ]
}