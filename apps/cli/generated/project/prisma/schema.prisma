generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  scans         ScanResult[]
}

model ScanResult {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  jobTitle        String
  matchScore      Int
  keywordCoverage Json
  aiInsights      String?
  createdAt       DateTime @default(now())
}